/* ===========================
    Базовая тема приложения
   =========================== */

QWidget {
    background-color: #F4F6F8;
    color: #1F2937;
    font-size: 9pt;
}

QMainWindow {
    background-color: #F4F6F8;
}

QLabel {
    background-color: transparent;
    color: #1F2937;
}

/* ===========================
    Поля ввода
   =========================== */

QLineEdit,
QDateEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    min-height: 36px;

    padding: 0 10px;

    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5D8;
    border-radius: 6px;

    selection-background-color: #2563EB;
    selection-color: #FFFFFF
}

QLineEdit:hover,
QDateEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #9CA3AF;
}

QLineEdit:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #2563EB;
}

QLineEdit:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #E9EDF2;
    color: #8A94A3;
    border-color: #D7DCE2;
}

QComboBox {
    padding-right: 30px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;

    width: 30px;

    border: none;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5D8;

    selection-background-color: #E8F0FE;
    selection-color: #1D4ED8;

    outline: 0;
}

/* ===========================
    Кнопки
   =========================== */

QPushButton {
    min-height: 36px;

    padding: 0 16px;

    background-color: #FFFFFF;
    color: #374151;

    border: 1px solid #D1D5D8;
    border-radius: 6px;

    font-weight: 500;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #EEF2F7;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* ===========================
    Боковая панель
   =========================== */

#sidebarWidget {
    background-color: #172333;
}

#sidebarWidget QLabel {
    background-color: transparent;
}

#appTitleLabel{
    color: #FFFFFF;
    font-size: 18pt;
    font-weight: 700;
    padding-left: 12px;
}

#appSubtitleLabel {
    color: #9EADBC;
    font-size: 9pt;
    padding-left: 12px;
}

/* ===========================
    Навигация
   =========================== */

#sidebarWidget QPushButton {
    min-height: 42px;

    padding-left: 16px;
    padding-right: 12px;

    border: 1px solid transparent;
    border-radius: 7px;

    background-color: transparent;

    color: #D6DEE7;

    font-size: 9pt;
    font-weight: 500;

    text-align: left;
}

#sidebarWidget QPushButton:hover {
    background-color: #223247;
    color: #FFFFFF;
    border-color: transparent;
    font-weight: 600;
}

#sidebarWidget QPushButton:checked {
    background-color: #2563EB;
    color: #FFFFFF;
    border-color: #3B82F6;
    font-weight: 600;
}

#sidebarWidget QPushButton:pressed {
    background-color: #1D4ED8;
}

#sidebarWidget #aboutButton {
    background-color: transparent;
    color: #9EADBC;
    border: 1px solid #304157;
}

#sidebarWidget #aboutButton:hover {
    background-color: #223247;
    color: #FFFFFF;
}


/* ===========================
    Группы
   =========================== */

QTextEdit,
QPlainTextEdit,
QListWidget,
QTreeWidget {
    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5D8;
    border-radius: 6px;

    selection-background-color: #E8F0FE;
    selection-color: #1D4ED8;
}


/* ===========================
    Вкладки
   =========================== */

QTabWidget::pane {
    border: none;
    background-color: #F4F6F8;
}

QTabWidget::tab-bar {
    left: 0px;
}

QTabBar {
    background-color: #F4F6F8;
}

QTabBar::tab {
    min-width: 120px;
    min-height: 42px;

    padding: 0 14px;

    background-color: transparent;
    color: #6B7280;

    border: none;
    border-bottom: 3px solid transparent;

    font-size: 9pt;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #2563EB;
    background-color: #EEF3F8;
}

QTabBar::tab:selected {
    color: #1D4ED8;
    background-color: transparent;

    border-bottom: 3px solid #2563EB;

    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #B6BDC7;
}

/* ===========================
    Заголовок страницы
   =========================== */

#pageHeaderWidget {
    background-color: transparent;
}

#pageTitleLabel {
    background-color: transparent;
    color: #0F1F38;

    font-size: 20pt;
    font-weight: 700;
}

#pageSubtitleLabel {
    background-color: transparent;

    color: #6B7280;

    font-size: 9pt;
    font-weight: 400;
}

/* ===========================
    Карточки CreateActWidget
   =========================== */

QFrame[card="true"] {
    background-color: #FFFFFF;

    border: 1px solid #D6E0EA;
    border-radius: 8px;
}

QLabel[cardTitle="true"] {
    min-height: 42px;
    max-height: 42px;

    padding-left: 18px;

    background-color: #EDF5FC;
    color: #0F1F38;

    border: none;
    border-bottom: 1px solid #DDE5EE;

    border-top-left-radius: 7px;
    border-top-right-radius: 7px;

    font-size: 10pt;
    font-weight: 600;
}

QWidget[cardBody="true"] {
    background-color: #FFFFFF;
    border: none;
}



/* ===========================
    Карточки CreateActWidget
   =========================== */

#actionBarSeparator {
    background-color: #D7E0EA;
    border: none;
    max-height: 1px;
}

QPushButton[buttonRole="primary"] {
    min-height: 42px;
    padding: 0 22px;

    background-color: #2563EB;
    color: #FFFFFF;

    border: 1px solid #2563EB;
    border-radius: 6px;

    font-weight: 600;
}

QPushButton[buttonRole="primary"]:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton[buttonRole="primary"]:pressed {
    background-color: #1E40AF;
    border-color: #1E40AF;
}

QPushButton[buttonRole="primary"]:disabled {
    background-color: #B8C7DC;
    border-color: #B8C7DC;
    color: #F8FAFC;
}

QPushButton[buttonRole="secondary"] {
    min-height: 42px;
    padding: 0 20px;

    background-color: #F8FAFC;
    color: #334155;

    border: 1px solid #CBD5E1;
    border-radius: 6px;

    font-weight: 500;
}

QPushButton[buttonRole="secondary"]:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton[buttonRole="secondary"]:pressed {
    background-color: #E2E8F0;
}

/* ===========================
    Scroll Bar
   =========================== */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

#externalRepresentativesScrollArea {
    background: transparent;
    border: none;
}

#externalRepresentativesScrollArea > QWidget > QWidget {
    background: transparent;
}

QPushButton[buttonRole="add"] {
    min-height: 34px;
    max-height: 34px;

    padding: 0 14px;

    background-color: #FFFFFF;
    color: #475569;

    border: 1px solid #CBD5E1;
    border-radius: 6px;

    font-weight: 500;
}

QPushButton[buttonRole="add"]:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #1E293B;
}

QPushButton[buttonRole="add"]:pressed {
    background-color: #F1F5F9;
}

QPushButton[buttonRole="dangerText"] {
    min-height: 30px;

    padding: 0 10px;

    background: transparent;
    color: #64748B;

    border: none;
    border-radius: 5px;
}

QPushButton[buttonRole="dangerText"]:hover {
    background-color: #FEF2F2;
    color:#DC2626;
}

QPushButton[buttonRole="dangerText"]:pressed {
    background-color: #FEE2E2;
    color: #B91C1C;
}

/* ===========================
    Карточка стороннего представителя
   =========================== */

QFrame#representativeCardFrame {
    background-color: #FFFFFF;
    border: 1px solid #D6E0EB;
    border-radius: 6px;
}

QFrame#representativeCardFrame QLabel {
    background: transparent;
    border: none;
}

QFrame#representativeCardFrame QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CFD8E3;
    border-radius: 5px;
}

QFrame#representativeCardFrame QPushButton {
    background: transparent;
    border: none;
}

















