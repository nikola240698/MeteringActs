/* ===========================
    Базовая тема приложения
   =========================== */

QWidget {
    background-color: #F4F6F8;
    color: #1F2937;
    font-size: 9pt;
}



QMainWindow {
    background-color: #F4F6F8;
}

QLabel {
    background-color: transparent;
    color: #1F2937;
}

/* ===========================
    Диалоговые окна
   =========================== */

QDialog {
    background-color: #F4F6F8;
    color: #1F2937;
}

QDialog QLabel {
    background-color: transparent;
    color: #1F2937;
}

/* ===========================
    Поля ввода
   =========================== */

QLineEdit,
QDateEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    min-height: 36px;

    padding: 0 10px;

    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5D8;
    border-radius: 6px;

    selection-background-color: #2563EB;
    selection-color: #FFFFFF
}

QLineEdit:hover,
QDateEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #9CA3AF;
}

QLineEdit:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #2563EB;
}

QLineEdit:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #E9EDF2;
    color: #8A94A3;
    border-color: #D7DCE2;
}

QComboBox,
QDateEdit {
    padding-right: 36px;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;

    width: 36px;

    border: none;
    background: transparent;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(:/icons/combo-arrow.svg);

    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5D8;

    selection-background-color: #E8F0FE;
    selection-color: #1D4ED8;

    outline: 0;
}


/* ===========================
    Кнопки
   =========================== */

QPushButton {
    min-height: 36px;

    padding: 0 16px;

    background-color: #FFFFFF;
    color: #374151;

    border: 1px solid #D1D5D8;
    border-radius: 6px;

    font-weight: 500;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #EEF2F7;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* ===========================
    Боковая панель
   =========================== */

#sidebarWidget {
    background-color: #172333;
}

#sidebarWidget QLabel {
    background-color: transparent;
}

#appTitleLabel{
    color: #FFFFFF;
    font-size: 18pt;
    font-weight: 700;
    padding-left: 12px;
}

#appSubtitleLabel {
    color: #9EADBC;
    font-size: 9pt;
    padding-left: 12px;
}

/* ===========================
    Навигация
   =========================== */

#sidebarWidget QPushButton {
    min-height: 42px;

    padding-left: 16px;
    padding-right: 12px;

    border: 1px solid transparent;
    border-radius: 7px;

    background-color: transparent;

    color: #D6DEE7;

    font-size: 9pt;
    font-weight: 500;

    text-align: left;
}

#sidebarWidget QPushButton:hover {
    background-color: #223247;
    color: #FFFFFF;
    border-color: transparent;
    font-weight: 600;
}

#sidebarWidget QPushButton:checked {
    background-color: #2563EB;
    color: #FFFFFF;
    border-color: #3B82F6;
    font-weight: 600;
}

#sidebarWidget QPushButton:pressed {
    background-color: #1D4ED8;
}

#sidebarWidget #aboutButton {
    background-color: transparent;
    color: #9EADBC;
    border: 1px solid #304157;
}

#sidebarWidget #aboutButton:hover {
    background-color: #223247;
    color: #FFFFFF;
}

/* ===========================
    CheckBox
   =========================== */

QCheckBox {
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;

    background-color: #FFFFFF;
    border: 1px solid #94A3B8;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #3B82F6;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;

    image: url(:/icons/check.svg);
}

QCheckBox::indicator:checked:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QCheckBox::indicator:disabled {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

/* ===========================
    Группы
   =========================== */

QTextEdit,
QPlainTextEdit,
QListWidget,
QTreeWidget {
    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5D8;
    border-radius: 6px;

    selection-background-color: #E8F0FE;
    selection-color: #1D4ED8;
}


/* ===========================
    Вкладки
   =========================== */

QTabWidget::pane {
    border: none;
    background-color: #F4F6F8;
}

QTabWidget::tab-bar {
    left: 0px;
}

QTabBar {
    background-color: #F4F6F8;
}

QTabBar::tab {
    min-width: 120px;
    min-height: 42px;

    padding: 0 14px;

    background-color: transparent;
    color: #6B7280;

    border: none;
    border-bottom: 3px solid transparent;

    font-size: 9pt;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #2563EB;
    background-color: #EEF3F8;
}

QTabBar::tab:selected {
    color: #1D4ED8;
    background-color: transparent;

    border-bottom: 3px solid #2563EB;

    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #B6BDC7;
}

/* ===========================
    Заголовок страницы
   =========================== */

#pageHeaderWidget {
    background-color: transparent;
}

#pageTitleLabel {
    background-color: transparent;
    color: #0F1F38;

    font-size: 20pt;
    font-weight: 700;
}

#pageSubtitleLabel {
    background-color: transparent;

    color: #6B7280;

    font-size: 9pt;
    font-weight: 400;
}

/* ===========================
    Карточки CreateActWidget
   =========================== */

QFrame[card="true"] {
    background-color: #FFFFFF;

    border: 1px solid #D6E0EA;
    border-radius: 8px;
}

QLabel[cardTitle="true"] {
    min-height: 42px;
    max-height: 42px;

    padding-left: 18px;

    background-color: #EDF5FC;
    color: #0F1F38;

    border: none;
    border-bottom: 1px solid #DDE5EE;

    border-top-left-radius: 7px;
    border-top-right-radius: 7px;

    font-size: 10pt;
    font-weight: 600;
}



QWidget[cardBody="true"] {
    background-color: #FFFFFF;
    border: none;
}

/* ===========================
    Карточки MeterContainer
   =========================== */

#meterContainerWidget,
#seccondMeterContainerWidget,
#MeterActWidget {
    background-color: transparent;
}


/* ===========================
    Карточки CreateActWidget
   =========================== */

#actionBarSeparator {
    background-color: #D7E0EA;
    border: none;
    max-height: 1px;
}

/* ===========================
    Кнопки
   =========================== */

QPushButton[buttonRole="primary"] {
    min-height: 42px;
    padding: 0 22px;

    background-color: #2563EB;
    color: #FFFFFF;

    border: 1px solid #2563EB;
    border-radius: 6px;

    font-weight: 600;
}

QPushButton[buttonRole="primary"]:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton[buttonRole="primary"]:pressed {
    background-color: #1E40AF;
    border-color: #1E40AF;
}

QPushButton[buttonRole="primary"]:disabled {
    background-color: #B8C7DC;
    border-color: #B8C7DC;
    color: #F8FAFC;
}


QPushButton[buttonRole="secondary"] {
    min-height: 42px;
    padding: 0 20px;

    background-color: #F8FAFC;
    color: #334155;

    border: 1px solid #CBD5E1;
    border-radius: 6px;

    font-weight: 500;
}

QPushButton[buttonRole="secondary"]:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton[buttonRole="secondary"]:pressed {
    background-color: #E2E8F0;
}

QPushButton[buttonRole="secondary"]:disabled {
    background-color: #F3F4F6;
    border-color: #E5E7EB;
    color: #9CA3AF;
}


QPushButton[buttonRole="danger"] {
    min-height: 42px;
    padding: 0 18px;

    background-color: #FFFFFF;
    color: #DC2626;

    border: 1px solid #FCA5A5;
    border-radius: 6px;

    font-weight: 500;
}

QPushButton[buttonRole="danger"]:hover {
    background-color: #FEF2F2;
    color: #B91C1C;

    border-color: #F87171;
}

QPushButton[buttonRole="danger"]:pressed {
    background-color: #FEE2E2;
    color: #991B1B;

    border-color: #EF4444;
}

QPushButton[buttonRole="danger"]:disabled {
    background-color: #F3F4F6;
    border-color: #E5E7EB;
    color: #9CA3AF;
}


/* ===========================
    Scroll Bar
   =========================== */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

#externalRepresentativesScrollArea {
    background: transparent;
    border: none;
}

#externalRepresentativesScrollArea > QWidget > QWidget {
    background: transparent;
}

QPushButton[buttonRole="add"] {
    min-height: 34px;
    max-height: 34px;

    padding: 0 14px;

    background-color: #FFFFFF;
    color: #475569;

    border: 1px solid #CBD5E1;
    border-radius: 6px;

    font-weight: 500;
}

QPushButton[buttonRole="add"]:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #1E293B;
}

QPushButton[buttonRole="add"]:pressed {
    background-color: #F1F5F9;
}

QPushButton[buttonRole="dangerText"] {
    min-height: 30px;

    padding: 0 10px;

    background: transparent;
    color: #64748B;

    border: none;
    border-radius: 5px;
}

QPushButton[buttonRole="dangerText"]:hover {
    background-color: #FEF2F2;
    color:#DC2626;
}

QPushButton[buttonRole="dangerText"]:pressed {
    background-color: #FEE2E2;
    color: #B91C1C;
}

/* ===========================
    Карточка стороннего представителя
   =========================== */

QFrame#representativeCardFrame {
    background-color: #FFFFFF;
    border: 1px solid #D6E0EB;
    border-radius: 6px;
}

QFrame#representativeCardFrame QLabel {
    background: transparent;
    border: none;
}

QFrame#representativeCardFrame QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CFD8E3;
    border-radius: 5px;
}

QFrame#representativeCardFrame QPushButton {
    background: transparent;
    border: none;
}

QPushButton#addExternalRepresentativeButton {
    qproperty-icon: url(:/icons/add.svg);
    qproperty-iconSize: 18px 18px;
}




/* ===========================
    Карточка ТТ
   =========================== */

#CurrentTransformerPhaseWidget #phaseTitleLabel {
    background-color: transparent;
    color: #475569;
    font-weight: 600;
    padding: 0;
}

#CurrentTransformerPhaseWidget #phaseGroupBox {
    background-color: #FFFFFF;

    border: 1px solid #D3E0EA;
    border-radius: 7px;
}

#CurrentTransformerPhaseWidget #stateStackedWidget,
#CurrentTransformerPhaseWidget #emptyPage,
#CurrentTransformerPhaseWidget #dataPage {
    background-color: transparent;
}

#CurrentTransformerPhaseWidget #addButton {
    min-height: 0;

    padding: 0;

    background-color: transparent;
    color: #64748B;

    border: none;
    border-radius: 6px;

    font-size: 16pt;
    font-weight: 400;
}

#CurrentTransformerPhaseWidget #addButton:hover {
    background-color: #F8FAFC;
    color: #2563EB;
}

#CurrentTransformerPhaseWidget #addButton:pressed {
    background-color: #F1F5F9;
    color: #2563EB;
}

#removedCtPhaseContainer,
#installedCtPhaseContainer {
    background-color: transparent;
}

/* ===========================
    Кнопки карточки ТТ
   =========================== */

#CurrentTransformerPhaseWidget #editButton {
    min-height: 30px;
    max-height: 30px;

    padding: 0 10px;

    background-color: #EFF6FF;
    color: #2563EB;

    border: 1px solid #BFDBFE;
    border-radius: 6px;

    font-weight: 500;
}

#CurrentTransformerPhaseWidget #editButton:hover {
    background-color: #DBEAFE;
    border-color: #93C5FD;
    color: #1D4ED8;
}

#CurrentTransformerPhaseWidget #editButton:pressed {
    background-color: #BFDBFE;
    border-color: #60A5FA;
}

#CurrentTransformerPhaseWidget #clearButton {
    min-height: 30px;
    max-height: 30px;

    padding: 0 10px;

    background-color: transparent;
    color: #64748B;

    border: 1px solid #CBD5E1;
    border-radius: 6px;

    font-weight: 400;
}

#CurrentTransformerPhaseWidget #clearButton:hover {
    background-color: #FEF2F2;
    border-color: #FECACA;
    color: #DC2626;
}

#CurrentTransformerPhaseWidget #clearButton:pressed {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
    color: #B91C1C;
}

#CurrentTransformerPhaseWidget #cancelButton {
    min-height: 30px;
    max-height: 30px;

    padding: 0 10px;

    background-color: #FFFFFF;
    color: #475569;

    border: 1px solid #CBD5E1;
    border-radius: 6px;

    font-weight: 400;
}

#CurrentTransformerPhaseWidget #cancelButton:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #334155;
}

#CurrentTransformerPhaseWidget #cancelButton:pressed {
    background-color: #F1F5F9;
}

#CurrentTrnaformerPhaseWidget #findButton {
    min-height: 30px;
    max-height: 30px;
    padding: 0 10px;
}

/* ===========================
    Карточка векторной диаграммы
   =========================== */

#vectorDiagramCardBody,
#vectorDiagramContainerWidget,
#vectorDiagramContainerWidget QWidget {
    background-color: #FFFFFF;
}

#vectorDiagramContainerWidget QGroupBox {
    background-color: transparent;
    border: none;
    border-radius: 0;

    margin-top: 20px;

    font-weight: 600;
    color: #475569;
}

#vectorDiagramContainerWidget QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    left: 0;
    padding: 0;

    background-color: transparent;
    color: #475569;

    font-weight: 600;
}

/* ===========================
    Поле ввода пломбы
   =========================== */

QWidget#sealWidget,
QWidget#workScheduleWidget {
    background-color: transparent;
}

/* ===========================
   Область сторонних представителей
   =========================== */

QScrollArea#externalRepresentativesScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#externalRepresntativesScrollArea > QWidget,
QWidget#externalRepresentativesScrollContents,
QWidget#externalRepresentativesContainer {
    background: transparent;
}


/* ===========================
    Таблицы
   =========================== */

QTableView {
    border-color: #FFFFFF;
    alternate-background-color: #F8FAFC;

    color: #334155;

    border: 1px solid #D6E0EA;
    border-radius: 6px;

    gridline-color: #E2E8F0;

    selection-background-color: #E8F0FE;
    selection-color: #1D4ED8;

    outline: 0;
}

QTableView::item {
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #E8EDF3;
}

QTableView::item:selected {
    background-color: #E8F0FE;
    color: #1D4ED8;
}

QHeaderView::section {
    min-height: 34px;

    padding: 0 8px;

    background-color: #F8FAFC;
    color: #475569;

    border: none;
    border-right: 1px solid #E2E8F0;
    border-bottom: 1px solid #D6E0EA;

    font-weight: 600;
}

QHeaderView::section:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #F8FAFC;
    border: none;
    border-right: 1px solid #E2E9F0;
    border-bottom: 1px solid #D6E0EA;
}

/* ===========================
    История приборов учета
   =========================== */

#historyCard #historyLabel {
    min-height: 38px;
    max-height: 38px;
    padding-left: 16px;
}

#historyCard QTableView {
    border: none;
    border-radius: 0;
}

#addMeterButton {
    qproperty-icon: url(:/icons/add-white.svg);
    qproperty-iconSize: 18px 18px;
}
#editMeterButton {
    qproperty-icon: url(:/icons/edit.svg);
    qproperty-iconSize: 18px 18px;
}

#deleteMeterButton {
    qproperty-icon: url(:/icons/delete.svg);
    qproperty-iconSize: 18px 18px;
}

#addMeterButton,
#editMeterButton,
#deleteMeterButton {
    min-height: 36px;
    max-height: 36px;

    padding-left: 16px;
    padding-right: 16px;
}

/* ===========================
    История трансформаторов тока
   =========================== */

#ctHistoryCard QTableView {
    border: none;
    border-radius: 0;
}

#ctHistoryCard #historyLabel {
    min-height: 38px;
    max-height: 38px;
    padding-left: 16px;
}

#addCtButton,
#editCtButton,
#deleteCtButton {
    min-height: 36px;
    max-height: 36px;

    padding-left: 16px;
    padding-right: 16px;
}

#addCtButton {
    qproperty-icon: url(:/icons/add-white.svg);
    qproperty-iconSize: 18px 18px;
}

#editCtButton {
    qproperty-icon: url(:/icons/edit.svg);
    qproperty-iconSize: 18px 18px;
}

#deleteCtButton {
    qproperty-icon: url(:/icons/delete.svg);
    qproperty-iconSize: 18px 18px;
}

QWidget[cardHeader="true"] {
    background-color: #EDF5FC;

    border: none;
    border-bottom: 1px solid #DDE5EE;

    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}

#metersToolBarWidget QLabel,
#ctToolBarWidget QLabel {
    color: #0F1F38;
    font-weight: 600;
}



/* ===========================
    Календарь
   =========================== */

QCalendarWidget {
    min-width: 300px;
    min-height: 250px;

    background-color: #FFFFFF;
    border: 1px solid #D8E2EE;
}

/* Верхняя панель: меясц, год, стрелки */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    min-height: 40px;

    background-color: #EDF5FC;
    border-bottom: 1px solid #D8E2EE;
}

/* Месяц и год */
QCalendarWidget QToolButton {
    min-height: 30px;

    padding: 0 8px;

    background-color: transparent;
    color: #0F1F38;

    border: none;
    border-radius: 5px;

    font-weight: 600;
}

/* Кнопки предыдущего и следующего месяца */
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;

    padding: 0;

    background-color: #DCEBFA;
    border: 1px solid #C7D9EC;
    border-radius: 6px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth:hover,
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background-color: #C9E0F7;
    border-color: #AFCBE8;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth:pressed,
QCalendarWidget QToolButton#qt_calendar_nextmonth:pressed {
    background-color: #B8D6F3;
}

QCalendarWidget QToolButton:hover {
    background-color: #DCEBFA;
}

/* Таблица дней */
QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #334155;

    border: none;
    outline: none;

    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* Поле редактирования года */
QCalendarWidget QSpinBox {
    min-height: 30px;

    background-color: #FFFFFF;
    color: #0F1F38;

    border: 1px solid #CBD5E1;
    border-radius: 5px;
}

/* Кнопки изменения года */
QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    width: 16px;
}


/* ===========================
    Справочники
   =========================== */

QPushButton[buttonIcon="add-white"] {
    qproperty-icon: url(:/icons/add-white.svg);
    qproperty-iconSize: 18px 18px;
}

QPushButton[buttonIcon="edit"] {
    qproperty-icon: url(:/icons/edit.svg);
    qproperty-iconSize: 18px 18px;
}

QPushButton[buttonIcon="delete"] {
    qproperty-icon: url(:/icons/delete.svg);
    qproperty-iconSize: 18px 18px;
}

QPushButton[flatNavigation="true"] {
    qproperty-icon: url(:/icons/arrow-left.svg);
    qproperty-iconSize: 16px 16px;

    background-color: transparent;
    border: none;
    padding: 0 4px 0 0;
    color: #64748B;
    font-weight: 500;
}

QPushButton[flatNavigation="true"]:hover {
    color: #2563EB;
}

QPushButton[flatNavigation="true"]:pressed {
    color: #1D4ED8;
}

QLabel[cardHeaderTitle="true"] {
    background: transparent;
    border: none;
    color: #0F172A;
    font-size: 12pt;
    font-weight: 600;
}

/* ===========================
    Сотрудники
   =========================== */

QPushButton[buttonDismiss="true"] {
    min-height: 42px;
    max-height: 42px;

    background-color: #FFFFFF;
    color: #D97706;
    border: 1px solid #F59E0B;
    border-radius: 6px;
}

QPushButton[buttonDismiss="true"]:hover {
    background-color: #FFFBEB;
    border-color: #D97706;
    color: #B45309;
}

QPushButton[buttonDismiss="true"]:pressed {
    background-color: #FEF3C7;
    border-color: #B45309;
    color:#92400E;
}

QPushButton[buttonDismiss="true"]:disabled {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    color: #94A3B8;
}

QPushButton[buttonReinstate="true"] {
    min-height: 42px;
    max-height: 42px;

    background-color: #FFFFFF;
    color: #16A34A;
    border: 1px solid #22C55E;
    border-radius: 6px;
}

QPushButton[buttonReinstate="true"]:hover {
    background-color: #F0FDF4;
    border-color: #16A34A;
    color: #15803D;
}

QPushButton[buttonReinstate="true"]:pressed {
    background-color: #DCFCE7;
    border-color: #15803D;
    color:#166534;
}

QPushButton[buttonReinstate="true"]:disabled {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    color: #94A3B8;
}

/* ===========================
    Архив актов
   =========================== */



QPushButton[buttonIcon="open"] {
    qproperty-icon: url(:/icons/open.svg);
    qproperty-iconSize: 18px 18px;
}

QPushButton[buttonIcon="export"] {
    qproperty-icon: url(:/icons/export.svg);
    qproperty-iconSize: 18px 18px;
}

QPushButton[buttonIcon="reset"] {
    qproperty-icon: url(:/icons/reset.svg);
    qproperty-iconSize: 18px 18px;
}


/* ===========================
    Настройки
   =========================== */

/* Заголовок страницы */
SettingsWidget > QLabel#titleLabel {
    color: #0F1F38;
    font-size: 16pt;
    font-weight: 600;
}

/* Подзаголовок страницы */
SettingsWidget > QLabel#subtitleLabel {
    color: #64748B;
    font-size: 9pt;
}

/* Основные заголовки карточек */
SettingsWidget QLabel#dbLabel,
SettingsWidget QLabel#documentCardTitleLabel,
SettingsWidget QLabel#backupTitleLabel,
SettingsWidget QLabel#restoreTitleLabel {
    color: #0F1F38;
    font-size: 10pt;
    font-weight: 600;
}

/* Описания в заголовках карточек */
SettingsWodget QLabel#databaseSubtitleLabel,
SettingsWidget Qlabel#documentCardSubtitleLabel,
SettingsWidget Qlabel#backupSubtitleLabel,
SettingsWidget QLabel#restoreSubtitleLabel {
    color: #64748B;
    font-size: 8.5pt;
    font-weight: 400;
}

/* Пояснение автоматического резервного копирования */
SettingsWidget Qlabel#backupInformationLabel {
    color: #64748B;
    font-size: 8.5pt;
}

/* Инофрмация о аоследней резервной копии */
SettingsWidget Qlabel#lastBackupLabel {
    color: #64748B;
}

/* Read-only пути */
SettingsWidget QLineEdit[readOnly="true"] {
    background-color: #F8FAFC;
    color: #475569;
}

/* Информационное сообщение восстановления */
SettingsWidget QLabel#restoreInformationLabel {
    padding: 10px 12px;

    background-color: #EFF6FF;
    color: #475569;

    border: 1px solid #DBEAFE;
    border-radius: 6px;
}

/* ===========================
    Header'ы на старнице настройки
   =========================== */

SettingsWidget QFrame#databaseIconFrame {
    background-color: #DCE8FF;
    border: none;
    border-radius: 22px;
}

SettingsWidget QFrame#documentIconFrame {
    background-color: #D7EEF8;
    border: none;
    border-radius: 22px;
}

SettingsWidget QFrame#backupIconFrame {
    background-color: #D7F2E7;
    border: none;
    border-radius: 22px;
}

SettingsWidget QFrame#restoreIconFrame {
    background-color: #E2E2FF;
    border: none;
    border-radius: 22px;
}

SettingsWidget Qlabel#databaseIconLabel,
SettingsWidget QLabel#documentIconLabel,
SettingsWidget QLabel#backupIconLabel,
SettingsWidget Qlabel#restoreIconLabel {
    background: transparent;
    border: none;
}











